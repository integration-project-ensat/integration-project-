# GitLab Role Sync Configuration
# This file contains credentials and settings for syncing roles to GitLab

# GitLab API Token (Personal Access Token or Admin Token with API scope)
# Create one in GitLab: Admin > Personal Access Tokens
# Scopes needed: api, read_api, write_repository, admin
GITLAB_TOKEN=gitlab_admin_token

# GitLab instance URL
GITLAB_URL=http://localhost:9080

# GitLab group ID 
GROUP_ID=1

#GitLab project ID 
PROJECT_ID=1

# Keycloak settings (for future integration if needed)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=portfolio-realm
KEYCLOAK_CLIENT_ID=sync-script
KEYCLOAK_CLIENT_SECRET=gitlab_keycloak_client_secret

