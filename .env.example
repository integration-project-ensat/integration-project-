```env
# Template for project environment variables.
# Copy this file to `.env` and fill in the values locally.

DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

PORT=<PORT>
NODE_ENV=<NODE_ENV>
FRONTEND_URL=<FRONTEND_URL>
BACKEND_URL=<BACKEND_URL>

JWT_SECRET=<JWT_SECRET>
ADMIN_EMAIL=<ADMIN_EMAIL>
ADMIN_PASSWORD=<ADMIN_PASSWORD>
ADMIN_ACTION_SECRET=<ADMIN_ACTION_SECRET>
KEYCLOAK_ADMIN_USER=<KEYCLOAK_ADMIN_USER>
KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD>

GRAFANA_OAUTH_SECRET=<GRAFANA_OAUTH_SECRET>
PGADMIN_OAUTH_SECRET=<PGADMIN_OAUTH_SECRET>
GITLAB_OAUTH_SECRET=<GITLAB_OAUTH_SECRET>
SONAR_PASSWORD=<SONAR_PASSWORD>

SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
```
