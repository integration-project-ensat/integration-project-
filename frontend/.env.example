# Template des variables d'environnement côté frontend.
# Copiez ce fichier en .env et renseignez vos valeurs locales.
# Le .env réel ne doit jamais être committé.

# Par défaut, le frontend utilisera le proxy Vite vers /api.
VITE_API_BASE_URL=/api

# Si votre backend est servi sur un hôte différent, remplacez par la valeur complète :
# VITE_API_BASE_URL=http://localhost:3000/api
