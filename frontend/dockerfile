# Stage 1: Build Vuejs
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build 2>&1 | tee build.log || (cat build.log && exit 1)

# Stage 2: Just serve the files (no nginx)
FROM node:20-alpine
RUN npm install -g serve
COPY --from=build /app/dist /app
WORKDIR /app
EXPOSE 80
CMD ["serve", "-s", ".", "-l", "80"]
