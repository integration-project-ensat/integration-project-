// ============================================================
//  Prisma Schema — généré à partir du MCD
//  Datasource : PostgreSQL  |  Generator : prisma-client-js
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// ======================== ENUMS =============================

enum RoleUtilisateur {
  ETUDIANT
  PROFESSEUR
  PROFESSIONNEL
  ADMINISTRATEUR
}

enum StatutValidation {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum NiveauCompetence {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  EXPERT
}

enum TypeCompetence {
  TECHNIQUE
  COMPORTEMENTALE
}

enum NiveauCredibilite {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  EXPERT
}

// ================== UTILISATEUR & RÔLES =====================

model Utilisateur {
  id_utilisateur     Int       @id @default(autoincrement())
  nom                String
  prenom             String
  email              String    @unique
  mot_de_passe_hashe String
  role               RoleUtilisateur
  est_actif          Boolean   @default(true)
  est_valide         Boolean   @default(false)
  email_verifie     Boolean   @default(false)
  token_expires_at DateTime?
  email_verification String?
  date_creation      DateTime  @default(now())
  derniere_connexion DateTime?

  // Rôles (héritage 1-vers-1 optionnel)
  administrateur Administrateur?
  professionnel  Professionnel?
  professeur     Professeur?
  etudiant       Etudiant?

  // Relations
  notifications    Notification[]
  diplomes         Diplome[]
  competences      Competence[]
  activites        Activite[]
  recommandations  Recommandation[] // écrit

  @@map("utilisateur")
}

model Administrateur {
  id_utilisateur Int         @id
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("administrateur")
}

model Professionnel {
  id_utilisateur      Int         @id
  entreprise          String?
  poste               String?
  email_professionnel String?
  secteur             String?
  date_validation     DateTime?

  utilisateur     Utilisateur      @relation(fields: [id_utilisateur], references: [id_utilisateur])
  recommandations Recommandation[] // rédige

  @@map("professionnel")
}

model Professeur {
  id_utilisateur Int         @id
  code_administratif String?@unique
  departement    String?
  specialite     String?
  telephone      String?

  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("professeur")
}

model Etudiant {
  id_utilisateur      Int         @id
  numero_etudiant     String?     @unique
  annee_universitaire String?
  filiere             String?

  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])
  profil      Profil?
  projets     ProjetEtudiant[]
  stages      Stage[]

  @@map("etudiant")
}

// =================== PROFIL & PORTFOLIO =====================

model Profil {
  id_profil              Int       @id @default(autoincrement())
  id_utilisateur         Int       @unique
  photo_profil           String?
  telephone              String?
  ville                  String?
  date_naissance         DateTime?
  pays                   String?
  bio                    String?   @db.Text
  objectif_professionnel String?   @db.Text
  linkedin_url           String?

  etudiant     Etudiant      @relation(fields: [id_utilisateur], references: [id_utilisateur])
  badges       Badge[]
  commentaires Commentaire[]
  portfolio    Portfolio?

  @@map("profil")
}

model Portfolio {
  id_portfolio       Int       @id @default(autoincrement())
  id_profil          Int       @unique
  titre              String?
  objectif           String?   @db.Text
  theme              String?
  est_public         Boolean   @default(false)
  nombre_vues        Int       @default(0)
  dates_modification DateTime? @updatedAt
  date_export        DateTime?

  profil             Profil             @relation(fields: [id_profil], references: [id_profil])
  score_credibilite  ScoreCredibilite?
  github_integration GithubIntegration?

  @@map("portfolio")
}

model ScoreCredibilite {
  scoreID              Int    @id @default(autoincrement())
  id_portfolio         Int    @unique
  score_totale         Float  @default(0)
  score_projet         Float  @default(0)
  score_attestat       Float  @default(0)
  score_recommandation Float  @default(0)
  score_certification  Float  @default(0)
  score_stage          Float  @default(0)
  niveau               NiveauCredibilite?

  portfolio Portfolio @relation(fields: [id_portfolio], references: [id_portfolio])

  @@map("score_credibilite")
}

// =============== ELEMENT VALIDABLE (héritage) ===============
// Projet, Stage, Attestation, LettreRecommandation héritent
// de ElementValidable via une relation 1-1 sur id_element.

model ElementValidable {
  id_element      Int       @id @default(autoincrement())
  statut          StatutValidation @default(EN_ATTENTE)
  date_soumission DateTime?
  date_validation DateTime?

  // Sous-types (un seul rempli par ligne)
  projet                Projet?
  stage                 Stage?
  attestation           Attestation?
  lettre_recommandation LettreRecommandation?

  @@map("element_validable")
}

model Projet {
  id_element              Int      @id
  titre                   String?
  description             String?  @db.Text
  type                    String?
  role                    String?
  url_github              String?
  url_youtube             String?
  resultats               String?  @db.Text
  statut                  String?
  visible                 Boolean  @default(true)
  appreciation_professeur String?  @db.Text
  date_debut              DateTime?
  date_fin                DateTime?
  est_dans_portfolio      Boolean  @default(false)

  element_validable ElementValidable  @relation(fields: [id_element], references: [id_element])
  etudiants         ProjetEtudiant[]
  technologies      ProjetTechnologie[]

  @@map("projet")
}

model ProjetEtudiant {
  id_projet   Int
  id_etudiant Int

  projet   Projet   @relation(fields: [id_projet], references: [id_element])
  etudiant Etudiant @relation(fields: [id_etudiant], references: [id_utilisateur])

  @@id([id_projet, id_etudiant])
  @@map("projet_etudiant")
}

model Stage {
  id_element     Int       @id
  entreprise     String?
  date_debut     DateTime?
  date_fin       DateTime?
  duree_semaines Int?
  missions       String?   @db.Text
  statut         String?
  url_rapport    String?

  id_etudiant       Int?
  element_validable ElementValidable @relation(fields: [id_element], references: [id_element])
  etudiant          Etudiant?        @relation(fields: [id_etudiant], references: [id_utilisateur])

  @@map("stage")
}

model Attestation {
  id_element     Int       @id
  titre          String?
  type           String?
  date_obtention DateTime?
  organisme      String?
  description    String?   @db.Text

  element_validable ElementValidable @relation(fields: [id_element], references: [id_element])

  @@map("attestation")
}

model LettreRecommandation {
  id_element  Int     @id
  type        String?
  contenu     String? @db.Text
  url_fichier String?

  id_recommandation Int?
  element_validable ElementValidable @relation(fields: [id_element], references: [id_element])
  recommandation    Recommandation?  @relation(fields: [id_recommandation], references: [id_recommandation])

  @@map("lettre_recommandation")
}

// ===================== NOTIFICATION =========================

model Notification {
  id_notification Int      @id @default(autoincrement())
  type            String?
  message         String?  @db.Text
  est_lu          Boolean  @default(false)
  canal_envoi     String?
  date_reception  DateTime @default(now())
  cible_id        Int?
  cible_type      String?

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("notification")
}

// ======================== DIPLOME ===========================

model Diplome {
  id_diplome    Int     @id @default(autoincrement())
  titre_diplome String?
  domaine       String?
  annee_debut   Int?
  annee_fin     Int?
  description   String? @db.Text
  etablissement String?

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("diplome")
}

// ===================== COMPETENCE ===========================
// Compétence_technique et Compétence_comportementale sont
// modélisées via le champ discriminant `type` + `categorie`.

model Competence {
  id_competence Int              @id @default(autoincrement())
  nom           String?
  description   String?          @db.Text
  niveau        NiveauCompetence?
  type          TypeCompetence?
  categorie     String?          // catégorie technique si type = TECHNIQUE

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("competence")
}

// ====================== ACTIVITE ============================

model Activite {
  id_element      Int       @id @default(autoincrement())
  titre           String?
  type            String?
  description     String?   @db.Text
  date            DateTime?
  url_attestation String?
  date_validation DateTime?
  est_visible     Boolean   @default(true)

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur])

  @@map("activite")
}

// ================= BADGE & REGLE_BADGE ======================

model Badge {
  id_badge         Int       @id @default(autoincrement())
  nom              String?
  description      String?
  categorie        String?
  date_attribution DateTime?
  icon_url         String?
  critere_type     String?

  id_profil Int?
  profil    Profil?     @relation(fields: [id_profil], references: [id_profil])

  id_regle    Int?
  regle_badge RegleBadge? @relation(fields: [id_regle], references: [id_regle])

  @@map("badge")
}

model RegleBadge {
  id_regle    Int     @id @default(autoincrement())
  nom         String?
  description String?
  est_valide  Boolean @default(true)
  categorie   String?

  badges Badge[]

  @@map("regle_badge")
}

// ================== RECOMMANDATION ==========================

model Recommandation {
  id_recommandation Int     @id @default(autoincrement())
  type              String?
  contenu           String? @db.Text
  url_fichier       String?
  statut            String?
  visibilite        String?

  id_utilisateur   Int?
  utilisateur      Utilisateur?   @relation(fields: [id_utilisateur], references: [id_utilisateur])

  id_professionnel Int?
  professionnel    Professionnel? @relation(fields: [id_professionnel], references: [id_utilisateur])

  lettres LettreRecommandation[]

  @@map("recommandation")
}

// ==================== TECHNOLOGIE ===========================

model Technologie {
  id_technologie Int     @id @default(autoincrement())
  nom            String?
  description    String?
  est_valide     Boolean @default(true)
  categorie      String?

  projets ProjetTechnologie[]

  @@map("technologie")
}

model ProjetTechnologie {
  id_projet      Int
  id_technologie Int

  projet      Projet      @relation(fields: [id_projet], references: [id_element])
  technologie Technologie @relation(fields: [id_technologie], references: [id_technologie])

  @@id([id_projet, id_technologie])
  @@map("projet_technologie")
}

// ==================== COMMENTAIRE ===========================

model Commentaire {
  id_commentaire Int      @id @default(autoincrement())
  contenu        String?  @db.Text
  statut         String?
  date           DateTime @default(now())

  id_profil Int?
  profil    Profil? @relation(fields: [id_profil], references: [id_profil])

  @@map("commentaire")
}

// =============== GITHUB INTEGRATION =========================

model GithubIntegration {
  id_integration       Int       @id @default(autoincrement())
  id_portfolio         Int       @unique
  github_username      String?
  access_token         String?
  total_depot          Int       @default(0)
  date_synchronisation DateTime?

  portfolio Portfolio     @relation(fields: [id_portfolio], references: [id_portfolio])
  depots    DepotGithub[]

  @@map("github_integration")
}

model DepotGithub {
  id_depot      Int       @id @default(autoincrement())
  nom_depot     String?
  description   String?   @db.Text
  url_depot     String?
  nbr_commits   Int       @default(0)
  date_creation DateTime?
  est_public    Boolean   @default(true)

  id_integration Int?
  github_integration GithubIntegration? @relation(fields: [id_integration], references: [id_integration])

  postes Poste[]

  @@map("depot_github")
}

// ======================== POSTE =============================

model Poste {
  id_poste         Int      @id @default(autoincrement())
  date_publication DateTime @default(now())
  visibilite       String?
  description      String?  @db.Text

  id_depot     Int?
  depot_github DepotGithub? @relation(fields: [id_depot], references: [id_depot])

  @@map("poste")
}
