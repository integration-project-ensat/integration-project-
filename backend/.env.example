Template des variables d'environnement backend. 
Contient les paramètres de connexion à PostgreSQL,
 Keycloak, le port serveur et les secrets.
# PI2026-27 — Config .env 
#database
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=
#JWT
JWT_SECRET=

#Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

#email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=  
SMTP_PASSWORD=

#ADMIN
ADMIN_EMAIL=
ADMIN_PASSWORD=
